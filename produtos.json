import webbrowser

from kivy.app import App
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.scrollview import ScrollView
from kivy.uix.label import Label
from kivy.uix.button import Button
from kivy.uix.image import AsyncImage
from kivy.uix.gridlayout import GridLayout
from kivy.uix.textinput import TextInput
from kivy.core.window import Window
from kivy.graphics import Color, Rectangle, RoundedRectangle

Window.clearcolor = (0.96, 0.96, 0.98, 1)


# ===================== PRODUTOS =====================
PRODUTOS = [
    {
        "nome": "Produto em Destaque",
        "preco": "29.90",
        "imagem": "https://i.ibb.co/RpKpmBMC/no-mark-React-Native-snapshot-image-0.png",
        "link": "https://s.shopee.com.br/8fOXAtWnez"
    }
]


# ===================== CARD =====================
class ProdutoCard(BoxLayout):
    def __init__(self, produto, **kwargs):
        super().__init__(
            orientation='vertical',
            size_hint_y=None,
            height=300,
            padding=6,
            spacing=6
        )

        container = BoxLayout(orientation='vertical', padding=8, spacing=6)

        with container.canvas.before:
            Color(1, 1, 1, 1)
            self.bg = RoundedRectangle(radius=[18])

        def update_bg(instance, value):
            self.bg.pos = instance.pos
            self.bg.size = instance.size

        container.bind(pos=update_bg, size=update_bg)

        # ================= IMAGEM =================
        container.add_widget(
            AsyncImage(
                source=produto["imagem"],
                size_hint_y=None,
                height=130,
                allow_stretch=True,
                keep_ratio=True
            )
        )

        # ================= NOME =================
        container.add_widget(Label(
            text=produto["nome"],
            size_hint_y=None,
            height=40,
            font_size=15,
            bold=True,
            color=(0, 0, 0, 1)
        ))

        # ================= PREÇO =================
        container.add_widget(Label(
            text=f'R$ {produto["preco"]}',
            size_hint_y=None,
            height=25,
            font_size=14,
            color=(0.1, 0.6, 0.2, 1)
        ))

        # ================= BOTÃO =================
        botao = Button(
            text="VER OFERTA 🔥",
            size_hint_y=None,
            height=45,
            background_color=(0.1, 0.55, 1, 1),
            color=(1, 1, 1, 1),
            bold=True
        )

        botao.bind(on_press=lambda x: webbrowser.open(produto["link"]))

        container.add_widget(botao)

        self.add_widget(container)


# ===================== APP =====================
class MeuApp(App):
    def build(self):
        root = BoxLayout(orientation='vertical')

        # ================= HEADER =================
        header = BoxLayout(size_hint_y=None, height=80)

        with header.canvas.before:
            Color(0.08, 0.45, 0.95, 1)
            self.bg = Rectangle()

        def update_bg(instance, value):
            self.bg.pos = instance.pos
            self.bg.size = instance.size

        header.bind(pos=update_bg, size=update_bg)

        titulo = Label(
            text="[b]🔥 ACHADINHOS PROMO 🔥[/b]",
            markup=True,
            font_size=22,
            color=(1, 1, 1, 1)
        )

        header.add_widget(titulo)

        # ================= BUSCA =================
        search = TextInput(
            hint_text="Buscar produtos...",
            size_hint_y=None,
            height=45,
            multiline=False
        )

        # ================= GRID =================
        scroll = ScrollView()

        grid = GridLayout(
            cols=2,
            spacing=10,
            padding=10,
            size_hint_y=None
        )

        grid.bind(minimum_height=grid.setter('height'))

        for p in PRODUTOS:
            grid.add_widget(ProdutoCard(p))

        scroll.add_widget(grid)

        # ================= MONTAGEM =================
        root.add_widget(header)
        root.add_widget(search)
        root.add_widget(scroll)

        return root


MeuApp().run()
